@model List<TESTFRAMEWORK.Models.ResearcherViewModel>

@{
    ViewBag.Title = "รายชื่อนักวิจัย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="//cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<link rel="stylesheet" href="//cdn.datatables.net/1.13.4/css/dataTables.bootstrap5.min.css">
<script src="//cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="//cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>

<style>
    .container-custom {
        max-width: 95%;
    }

    .table thead th {
        background-color: #007bff;
        color: white;
        text-align: center;
        position: relative;
        top: 0;
        z-index: 0;
    }

    .table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .btn-custom {
        padding: 0.5rem 1.5rem;
        font-size: 1rem;
        border-radius: 30px;
    }

    .dataTables_filter input {
        border-radius: 20px;
        padding: 0.5rem;
    }

    .table td {
        vertical-align: middle;
    }

    .table .btn {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }

    .project-name-column {
        min-width: 300px !important;
        max-width: 600px;
        word-wrap: break-word;
        white-space: normal;
    }

    .form-control.form-control-sm {
        border-radius: 20px !important;
        margin-bottom: 1rem;
    }

    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: none !important;
        border: none !important;
    }

</style>
<!-- ปุ่มเพิ่มนักวิจัย -->

<div class="container-xxl flex-grow-1 container-p-y mt-xl-5">
   
    <div class="row">
        <div class="col-xl-12">
            <div class="card">
                <div class="d-flex justify-content-between align-items-center p-3 pt-4">
                    <h3 class="fw-bold">📑 ตารางเก็บข้อมูลวิจัย (บุคคลภายใน)</h3>
                    <a href="@Url.Action("CreateInternal")" class="btn text-white" style="background-color: #F26522;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="16" fill="currentColor" class="bi bi-plus icon-thicker m-md-1 " viewBox="0 0 16 16">
                            <path d="M8 1a.5.5 0 0 1 .5.5v6h6a.5.5 0 0 1 0 1h-6v6a.5.5 0 0 1-1 0v-6h-6a.5.5 0 0 1 0-1h6v-6A.5.5 0 0 1 8 1z" stroke="white" stroke-width="1.5" />
                        </svg>เพิ่มนักวิจัย
                    </a>
                    <a href="@Url.Action("DownloadTemplate", "Researcher")" class="btn btn-success text-white" style="border-radius: 30px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="16" fill="currentColor" class="bi bi-download m-md-1" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708l3 3z"/>
                        </svg>ดาวน์โหลด Template
                    </a>
                    <button type="button" class="btn btn-primary text-white" id="btnImport" style="border-radius: 30px; background-color: #007bff;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="16" fill="currentColor" class="bi bi-upload m-md-1" viewBox="0 0 16 16">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5z"/>
                            <path d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708l3-3z"/>
                        </svg>นำเข้า Excel
                    </button>
                    <input type="file" id="importFile" name="importFile" accept=".xlsx,.xls" style="display: none;" />
                    
                </div>
                <div class="card-header p-0">

                </div>
                <div class="card-body" style="padding-top: 0px;">
                    <div class="tab-content p-0">

                        <!-- ================================== แท็บ 1 : สถานะ = 1 (สำเร็จ) ================================== -->
                        <div class="tab-pane fade show active" id="navs-top-home" role="tabpanel">
                            <div class="card shadow-sm p-3">
                                <div class="table-responsive">
                                    <table id="example" class="table table-striped table-hover align-middle">
                                        <thead>
                                            <tr>
                                                <th>ชื่อ</th>
                                                <th>กลุ่มงาน / มหาวิทยาลัย</th>
                                                <th>ฝ่ายงาน / สำนัก</th>
                                                <th>แผนก</th>
                                                <th>ประเภทนักวิจัย</th>
                                                <th class="text-center">การจัดการ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Any())
                                            {
                                                foreach (var researcher in Model)
                                                {
                                                    <tr>
                                                        <td>@(researcher?.Title ?? "") @(researcher?.Name ?? "-")</td>
                                                        <td>
                                                            @(researcher?.WorkGroupName ?? "-")
                                                       
                                                                @if (researcher.StatusWorkGroup == 2)
                                                                {
                                                                    <!-- หาก StatusWorkGroup = 1 จะทำอะไรบางอย่าง -->
                                                                    <span class="badge rounded-pill bg-danger">(ยกเลิก)</span>
                                                                }
                                                                else
                                                                {
                                                                    <!-- หาก StatusWorkGroup ไม่ใช่ 1 -->
                                                                }
                                                        </td>
                                                        <td>
                                                            @(researcher?.DepartmentName ?? "-")

                                                            @if (researcher.StatusDepartment == 2)
                                                            {
                                                                <!-- หาก StatusWorkGroup = 1 จะทำอะไรบางอย่าง -->
                                                                <span class="badge rounded-pill bg-danger"> (ยกเลิก)</span>
                                                            }
                                                            else
                                                            {
                                                                <span class=""></span>
                                                                <!-- หาก StatusWorkGroup ไม่ใช่ 1 -->
                                                            }
                                                        </td>
                                                        <td>
                                                            @(researcher?.DivisionName ?? "-")
                                                            @if (researcher.StatusDivision == 2)
                                                            {
                                                                <span class="badge rounded-pill bg-danger"> (ยกเลิก)</span>
                                                                <!-- หาก StatusWorkGroup = 1 จะทำอะไรบางอย่าง -->
                                                            }
                                                            else
                                                            {
                                                                <span class=""></span>
                                                                <!-- หาก StatusWorkGroup ไม่ใช่ 1 -->
                                                            }
                                                        </td>
                                                        <td>@(researcher?.TypeResearchName ?? "-")</td>
                                                        <td style="min-width: 180px;">
                                                            <a href="@Url.Action("EditInternal", "Researcher", new { id = researcher?.ResearcherNumber ?? string.Empty })"
                                                               class="btn btn-warning btn-sm">✏️ แก้ไข</a>
                                                            <button type="button" class="btn btn-danger btn-sm"
                                                                    onclick="confirmDelete('@Html.Raw(researcher?.ResearcherNumber ?? string.Empty)')">
                                                                🗑️ ลบ
                                                            </button>
                                                        </td>
                                                    </tr>

                                                }
                                            }
                                           
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()


@section scripts {
    <script>
        @*console.log("ข้อมูลนักวิจัยทั้งหมด:", @Html.Raw(Json.Encode(Model)));*@

        // เรียกใช้งาน DataTable แยกแต่ละตาราง
        new DataTable('#example');


        function confirmDelete(projectId) {
            Swal.fire({
                title: "⚠️ ยืนยันการลบข้อมูล?",
                text: "ข้อมูลที่ลบไปแล้วจะไม่สามารถกู้คืนได้!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "✅ ใช่, ลบเลย!",
                cancelButtonText: "❌ ยกเลิก"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Researcher")',
                        type: 'POST',
                        data: {
                            id: projectId,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    '✅ ลบสำเร็จ!',
                                    'ข้อมูลถูกลบเรียบร้อยแล้ว.',
                                    'success'
                                ).then(() => location.reload());
                            } else {
                                Swal.fire('❌ เกิดข้อผิดพลาด!', response.message, 'error');
                            }
                        },
                        error: function (xhr, status, error) {
                            Swal.fire('❌ เกิดข้อผิดพลาด!', 'ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์', 'error');
                        }
                    });
                }
            });
        }

        // Import Excel
        $('#btnImport').click(function () {
            $('#importFile').click();
        });

        $('#importFile').change(function () {
            var fileInput = $(this);
            if (fileInput.val() === '') return;

            var formData = new FormData();
            formData.append('excelFile', fileInput[0].files[0]);
            formData.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

            Swal.fire({
                title: 'กำลังนำเข้าข้อมูล...',
                text: 'กรุณารอสักครู่',
                allowOutsideClick: false,
                allowEscapeKey: false,
                didOpen: function () { Swal.showLoading(); }
            });

            $.ajax({
                url: '@Url.Action("ImportFromExcel", "Researcher")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success && response.imported > 0) {
                        var errorText = response.errors && response.errors.length > 0
                            ? '\n\nรายการที่มีปัญหา:\n' + response.errors.join('\n')
                            : '';
                        Swal.fire({
                            icon: 'success',
                            title: 'นำเข้าสำเร็จ!',
                            html: response.message + errorText.replace(/\n/g, '<br>'),
                            confirmButtonText: 'ตกลง',
                            confirmButtonColor: '#28a745',
                            width: 600
                        }).then(function () { location.reload(); });
                    } else {
                        var errorMsg = response.message || 'ไม่สามารถนำเข้าได้';
                        if (response.errors && response.errors.length > 0) {
                            errorMsg += '\n\n' + response.errors.join('\n');
                        }
                        Swal.fire({
                            icon: 'error',
                            title: 'นำเข้าไม่สำเร็จ',
                            html: errorMsg.replace(/\n/g, '<br>'),
                            confirmButtonText: 'ตกลง',
                            width: 600
                        });
                    }
                    fileInput.val('');
                },
                error: function () {
                    Swal.fire({
                        icon: 'error',
                        title: 'เกิดข้อผิดพลาด',
                        text: 'ไม่สามารถอัปโหลดไฟล์ได้ กรุณาลองใหม่',
                        confirmButtonText: 'ตกลง'
                    });
                    fileInput.val('');
                }
            });
        });
    </script>
}