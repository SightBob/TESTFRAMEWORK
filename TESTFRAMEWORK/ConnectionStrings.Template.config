<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================
  TEMPLATE: ConnectionStrings.config
  ============================================
  ขั้นตอนการใช้งาน:
  1. คัดลอกไฟล์นี้เป็น "ConnectionStrings.config"
  2. แก้ไข Data Source และค่าต่างๆ ตามเครื่องของคุณ
  3. อย่า push "ConnectionStrings.config" ขึ้น Git (มีใน .gitignore แล้ว)

  ตัวอย่างการตั้งค่าสำหรับแต่ละสถานการณ์:
-->
<connectionStrings>

  <!-- ตัวอย่าง A: ใช้ LocalDB (แนะนำสำหรับ Dev) -->
  <add name="Research_DBEntities"
       connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Research_DB;Integrated Security=True;MultipleActiveResultSets=True;"
       providerName="System.Data.SqlClient" />

  <!-- ตัวอย่าง B: ใช้ SQL Server ที่มี Windows Authentication -->
  <!--
  <add name="Research_DBEntities"
       connectionString="Data Source=YOUR_SERVER_NAME;Initial Catalog=Research_DB;Integrated Security=True;MultipleActiveResultSets=True;"
       providerName="System.Data.SqlClient" />
  -->

  <!-- ตัวอย่าง C: ใช้ SQL Server ที่มี Username/Password (ไม่แนะนำ) -->
  <!--
  <add name="Research_DBEntities"
       connectionString="Data Source=YOUR_SERVER_NAME;Initial Catalog=Research_DB;User ID=YOUR_USER;Password=YOUR_PASSWORD;MultipleActiveResultSets=True;"
       providerName="System.Data.SqlClient" />
  -->

</connectionStrings>